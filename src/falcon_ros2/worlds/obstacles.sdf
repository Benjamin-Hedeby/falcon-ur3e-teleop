<?xml version="1.0" ?>
<!-- Gazebo world for Falcon force-feedback testing: a table block under the UR3e's
     ready pose and a wall in front of it. Each obstacle has a contact sensor that
     publishes on /obstacle_contacts (bridged to ROS by ur_gz_teleop.launch.py). -->
<sdf version="1.9">
  <world name="obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Top surface at z = 0.20 m (10 cm below the tool), directly under the tool at the ready pose (x 0.30, y 0.13) -->
    <model name="table">
      <static>true</static>
      <pose>0.30 0.13 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.25 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.25 0.20</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
        <sensor name="contact" type="contact">
          <contact><collision>collision</collision><topic>/obstacle_contacts</topic></contact>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Wall face at x = 0.45 m, 15 cm in front of the tool at the ready pose -->
    <model name="wall">
      <static>true</static>
      <pose>0.47 0.13 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.40 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.40 0.30</size></box></geometry>
          <material><ambient>0.3 0.4 0.7 0.8</ambient><diffuse>0.3 0.4 0.7 0.8</diffuse></material>
        </visual>
        <sensor name="contact" type="contact">
          <contact><collision>collision</collision><topic>/obstacle_contacts</topic></contact>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
